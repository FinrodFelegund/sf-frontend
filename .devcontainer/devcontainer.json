{
  "name": "sf-frontend",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
